# ---------- Database ----------
# Local dev: run `npm run db` in its own terminal (embedded PostgreSQL) and keep this URL.
# Production: any PostgreSQL URL (Neon, Supabase, VPS...).
DATABASE_URL="postgresql://postgres:postgres@localhost:54329/darna"

# ---------- Site ----------
# Public base URL, no trailing slash. Used for auth, links, WhatsApp messages, sitemap, OG tags.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ---------- Auth (Better Auth) ----------
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET="change-me"
BETTER_AUTH_URL="http://localhost:3000"

# Phone number (E.164) that the seed script makes ADMIN.
ADMIN_PHONE="+249900000000"

# ---------- OTP delivery ----------
# "console" logs the code to the server console (development).
# Add a real provider in lib/otp.ts and select it here.
OTP_PROVIDER="console"

# ---------- Photo storage ----------
# "local" writes to ./uploads (development). "r2" uses Cloudflare R2.
STORAGE_DRIVER="local"
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
# Public bucket URL or custom domain, no trailing slash, e.g. https://photos.example.com
R2_PUBLIC_URL=""

# ---------- Cron ----------
# Secret for GET /api/cron/expire-listings (send as "Authorization: Bearer <CRON_SECRET>").
CRON_SECRET="change-me"
